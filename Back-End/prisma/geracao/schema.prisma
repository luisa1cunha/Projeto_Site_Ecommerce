generator client {
  provider = "prisma-client-js"
  output   = "geracao"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  nome        String
  sobrenome   String?
  email       String       @unique
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senhaHash   String       @default("")
  role        UserRole     @default(USER)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  requestLogs RequestLog[]
}

model camisasfutebol {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String   @default("")
  preco     Float    @default(0)
  time      String   @default("")
  descricao String   @default("")
  imagens   String[] @default([])
  modelo    String   @default("")
  versao    String   @default("")
  tamanho   String   @default("")
  ano       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model RequestLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  method     String
  path       String
  statusCode Int
  durationMs Int
  ip         String?
  userAgent  String?
  userId     String?  @db.Uuid
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
}
